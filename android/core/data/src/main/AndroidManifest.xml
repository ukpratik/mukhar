<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into the app. M2: the analysis queue posts "results ready" (US-072) and talks are recorded and uploaded.
  M3: reminders (US-033), the read-aloud mic (US-002) and the offline banner (S07).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <receiver
            android:name="com.vaak.data.work.ReminderReceiver"
            android:exported="false" />

        <!-- System broadcasts reach non-exported receivers (they come from the system uid). -->
        <receiver
            android:name="com.vaak.data.work.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.vaak.data.work.ReminderOpenActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>

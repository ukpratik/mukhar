    <!-- S04 What leaves your phone -->
    <string name="disclosure_eyebrow">Before your first real talk</string>
    <string name="disclosure_title">What leaves your phone</string>
    <string name="disclosure_lead">To coach you, Vaak uses two online services. Here\'s exactly what they get.</string>
    <string name="disclosure_audio_title">Your audio goes to a speech service</string>
    <string name="disclosure_audio_body">It\'s sent only to turn your talk into text. We don\'t store it on our servers, and we switch off the speech service\'s own storage wherever it lets us.</string>
    <string name="disclosure_audio_what">Talk audio</string>
    <string name="disclosure_ai_title">The transcript goes to an AI</string>
    <string name="disclosure_ai_body">It writes your feedback: what went well and one thing to try. We only use AI services whose terms say they don\'t train on it.</string>
    <string name="disclosure_ai_what">Transcript only, no audio</string>
    <string name="disclosure_server_title">Nothing is stored on our server</string>
    <string name="disclosure_server_body">Your talks, transcripts and feedback live on this phone. Delete them any time in Settings.</string>
    <string name="disclosure_analytics_title">Also share usage and crash reports?</string>
    <string name="disclosure_analytics_body">Optional. Helps us fix bugs. No audio or transcripts.</string>
    <string name="disclosure_analytics_a11y">Share usage and crash reports (optional)</string>
    <string name="disclosure_policy">Which services, and what each keeps: privacy policy</string>
    <string name="disclosure_agree">Agree and continue</string>
    <string name="disclosure_not_now">Not now</string>
    <string name="declined_back">Back to what leaves your phone</string>
    <string name="declined_title">No problem. Your call.</string>
    <string name="declined_body">Talks need those two services, so they\'ll stay off for now. Nothing has been sent.</string>
    <string name="declined_offline">Word Gym and revision work fully on your phone</string>
    <string name="declined_streak">They keep your streak going too</string>
    <string name="declined_turn_on">Turn talks on any time from Today or Settings</string>
    <string name="declined_changed_mind">I\'ve changed my mind, agree</string>

